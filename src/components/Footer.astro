---

import { navBarConfig, complianceConfig, profileConfig, siteConfig } from "../config";
import { LinkPresets } from "../constants/link-presets";
import { LinkPreset, type NavBarLink } from "../types/config";
import { url } from "../utils/url-utils";

const currentYear = new Date().getFullYear();

const links: NavBarLink[] = navBarConfig.links.map(
	(item: NavBarLink | LinkPreset): NavBarLink => {
		if (typeof item === "number") {
			return LinkPresets[item];
		}
		return item;
	},
);
---

<footer class="site-footer mt-16 mb-10">
    <div class="flex items-baseline justify-between border-t border-[var(--line-divider)] pt-6 mb-10 select-none">
        <span class="font-mono text-xs tracking-[0.32em] uppercase text-black/40 dark:text-white/40">End · 完</span>
        <a href="#top" data-scroll-top class="font-mono text-xs tracking-[0.2em] uppercase text-black/40 dark:text-white/40 hover:text-[var(--primary)] transition-colors cursor-pointer">
            回到顶部 ↑
        </a>
    </div>

    <div class="footer-title font-display select-none" aria-hidden="true">
        {siteConfig.title}
    </div>

    <div class="mt-10 flex flex-col md:flex-row md:items-end justify-between gap-6">
        <nav class="flex gap-6" aria-label="Footer">
            {links.map((l) => (
                <a href={l.external ? l.url : url(l.url)} target={l.external ? "_blank" : null}
                   class="footer-nav-link text-sm font-bold text-black/60 dark:text-white/60 hover:text-[var(--primary)] dark:hover:text-[var(--primary)] transition-colors">
                    {l.name}
                </a>
            ))}
        </nav>

        <div class="text-50 text-sm md:text-right">
            <div>&copy; {currentYear} {profileConfig.name}</div>
            <div class="mt-1.5 inline-flex flex-wrap items-center gap-x-2 gap-y-1 md:justify-end text-xs text-black/40 dark:text-white/40">
                {complianceConfig.networkPoliceRecord && (
                    <span class="inline-flex items-center gap-1.5">
                        {"networkPoliceRecordIcon" in complianceConfig && complianceConfig.networkPoliceRecordIcon && (
                            <img src={complianceConfig.networkPoliceRecordIcon} alt="" class="h-4 w-auto shrink-0" loading="lazy" decoding="async">
                        )}
                        {complianceConfig.networkPoliceRecordUrl ? (
                            <a class="hover:text-[var(--primary)] transition-colors" href={complianceConfig.networkPoliceRecordUrl} rel="noreferrer" target="_blank">
                                {complianceConfig.networkPoliceRecord}
                            </a>
                        ) : (
                            <span>{complianceConfig.networkPoliceRecord}</span>
                        )}
                    </span>
                )}
                {complianceConfig.networkPoliceRecord && complianceConfig.icpRecord && <span>/</span>}
                {complianceConfig.icpRecord && (
                    <a class="hover:text-[var(--primary)] transition-colors" href="https://beian.miit.gov.cn/" target="_blank" rel="noreferrer">
                        {complianceConfig.icpRecord}
                    </a>
                )}
            </div>
            <div class="mt-1.5 text-xs text-black/30 dark:text-white/30">
                Powered by
                <a class="hover:text-[var(--primary)] transition-colors" target="_blank" rel="noreferrer" href="https://astro.build">Astro</a> &
                <a class="hover:text-[var(--primary)] transition-colors" target="_blank" rel="noreferrer" href="https://github.com/saicaca/fuwari">Fuwari</a>
                <span class="mx-1.5 opacity-40">·</span>
                <a class="footer-nav-link hover:text-[var(--primary)] transition-colors" href={url("/rss.xml/")} aria-label="RSS 订阅">RSS</a>
                <span class="mx-1.5 opacity-40">·</span>
                <button id="shortcuts-trigger" type="button" aria-haspopup="dialog" class="hover:text-[var(--primary)] transition-colors cursor-pointer">
                    快捷键 <kbd class="font-mono text-[0.68rem] border border-[var(--line-color)] rounded px-1 py-px">?</kbd>
                </button>
            </div>
        </div>
    </div>
</footer>

<style>
    .font-display {
        font-family: var(--font-display);
    }
    .footer-title {
        font-size: clamp(2.4rem, 6.5vw, 4.75rem);
        font-weight: 560;
        line-height: 1.05;
        letter-spacing: 0.01em;
        color: var(--line-color);
        transition: color 0.8s var(--ease-out-expo);
        cursor: default;
    }
    @media (hover: hover) {
        .footer-title:hover {
            color: var(--primary);
        }
    }
    .footer-nav-link {
        position: relative;
        padding-bottom: 2px;
    }
    .footer-nav-link::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: 0;
        width: 100%;
        height: 1.5px;
        background: var(--primary);
        transform: scaleX(0);
        transform-origin: left center;
        transition: transform 0.45s var(--ease-out-expo);
    }
    @media (hover: hover) {
        .footer-nav-link:hover::after {
            transform: scaleX(1);
        }
    }
</style>
