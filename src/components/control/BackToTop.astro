---
import { Icon } from "astro-icon/components";
---

<!-- There can't be a filter on parent element, or it will break `fixed` -->
<div class="back-to-top-wrapper hidden lg:block">
    <div id="back-to-top-btn" class="back-to-top-btn hide flex items-center rounded-2xl transition">
        <svg class="progress-ring" viewBox="0 0 64 64" aria-hidden="true">
            <circle class="progress-ring-track" cx="32" cy="32" r="28" pathLength="100"></circle>
            <circle id="progress-ring-bar" class="progress-ring-bar" cx="32" cy="32" r="28" pathLength="100"></circle>
        </svg>
        <button aria-label="Back to Top" class="btn-card h-[3.75rem] w-[3.75rem] rounded-2xl">
            <Icon name="material-symbols:keyboard-arrow-up-rounded" class="mx-auto"></Icon>
        </button>
    </div>
</div>

<style lang="stylus">
.back-to-top-wrapper
    width: 3.75rem
    height: 3.75rem
    position: absolute
    right: 0
    top: 0
    pointer-events: none

.back-to-top-btn
    color: var(--primary)
    font-size: 2.25rem
    font-weight: bold
    border: none
    position: fixed
    bottom: 10rem
    opacity: 1
    cursor: pointer
    transform: translateX(5rem)
    pointer-events: auto
    i
        font-size: 1.75rem
    &.hide
        transform: translateX(5rem) scale(0.9)
        opacity: 0
        pointer-events: none
    &:active
      transform: translateX(5rem) scale(0.9)

.progress-ring
    position: absolute
    inset: -4px
    width: calc(100% + 8px)
    height: calc(100% + 8px)
    transform: rotate(-90deg)
    pointer-events: none
    fill: none
.progress-ring-track
    stroke: var(--line-divider)
    stroke-width: 2
.progress-ring-bar
    stroke: var(--primary)
    stroke-width: 2
    stroke-linecap: round
    stroke-dasharray: 100
    stroke-dashoffset: 100

</style>

<script>
import { scrollToTarget } from "../../utils/motion";
import { thock } from "../../utils/audio";

const btn = document.getElementById("back-to-top-btn");
btn?.addEventListener("click", () => {
    scrollToTarget(0, { offset: 0 });
    thock();
});

/* Global scroll progress drawn as a ring around the button */
const ring = document.getElementById("progress-ring-bar");
if (ring) {
    let ticking = false;
    const draw = () => {
        ticking = false;
        const max = document.documentElement.scrollHeight - window.innerHeight;
        const p = max > 0 ? Math.min(1, window.scrollY / max) : 0;
        ring.style.strokeDashoffset = String(100 * (1 - p));
    };
    window.addEventListener(
        "scroll",
        () => {
            if (!ticking) {
                ticking = true;
                requestAnimationFrame(draw);
            }
        },
        { passive: true },
    );
    draw();
}
</script>
