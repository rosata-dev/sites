---
import path from "node:path";
import { licenseConfig, profileConfig, siteConfig } from "@site/config";
import { Icon } from "astro-icon/components";
import katexStyleUrl from "katex/dist/katex.min.css?url";
import ImageWrapper from "../../components/misc/ImageWrapper.astro";
import License from "../../components/misc/License.astro";
import Markdown from "../../components/misc/Markdown.astro";
import PostMetadata from "../../components/PostMeta.astro";
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { getSortedPosts } from "../../utils/content-utils";
import { formatDateToYYYYMMDD } from "../../utils/date-utils";
import { getDir, getPostUrlBySlug } from "../../utils/url-utils";

export async function getStaticPaths() {
	const blogEntries = await getSortedPosts();
	return blogEntries.map((entry) => ({
		params: { slug: entry.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();

// social card: a real cover wins if it's directly servable (public/remote);
// content-relative covers get hashed at build time and can't be known here,
// so those — and coverless essays — fall back to the generated card
const cover = entry.data.image;
const ogImage =
	cover && (/^https?:\/\//.test(cover) || cover.startsWith("/"))
		? cover
		: `/og/${entry.slug}.png`;
const ogImageAbs = new URL(ogImage, Astro.site).href;

// KaTeX CSS (~23KB + fonts) is only worth its render cost on pages that
// actually render math — sniff the raw markdown for TeX delimiters
const hasMath =
	/(\$\$[\s\S]+?\$\$)|(\\\([\s\S]+?\\\))|(\\\[[\s\S]+?\\\])|(\$[^\n$]+?\$)/.test(
		entry.body,
	);

const { remarkPluginFrontmatter } = await entry.render();

// related posts: shared tags weigh double, same category single; top 3 win
const allPosts = await getSortedPosts();
const entryTags = entry.data.tags ?? [];
const related = allPosts
	.filter((p) => p.slug !== entry.slug)
	.map((p) => {
		const shared = (p.data.tags ?? []).filter((t) =>
			entryTags.includes(t),
		).length;
		const sameCategory =
			p.data.category && p.data.category === entry.data.category ? 1 : 0;
		return { post: p, score: shared * 2 + sameCategory };
	})
	.filter((x) => x.score > 0)
	.sort((a, b) => b.score - a.score)
	.slice(0, 3)
	.map((x) => x.post);

// series: every sibling in the same named series, oldest first
const seriesPosts = entry.data.series
	? allPosts
			.filter((p) => p.data.series === entry.data.series)
			.sort((a, b) => a.data.published.getTime() - b.data.published.getTime())
	: [];
const seriesIndex = seriesPosts.findIndex((p) => p.slug === entry.slug);

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: entry.data.title,
	description: entry.data.description || entry.data.title,
	keywords: entry.data.tags,
	author: {
		"@type": "Person",
		name: profileConfig.name,
		url: Astro.site,
	},
	datePublished: formatDateToYYYYMMDD(entry.data.published),
	...(entry.data.updated && {
		dateModified: formatDateToYYYYMMDD(entry.data.updated),
	}),
	image: ogImageAbs,
	mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
	inLanguage: entry.data.lang
		? entry.data.lang.replace("_", "-")
		: siteConfig.lang.replace("_", "-"),
};
---
<MainGridLayout banner={entry.data.image} title={entry.data.title} description={entry.data.description} lang={entry.data.lang} setOGTypeArticle={true} ogImage={ogImage} headings={headings}>
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    <meta slot="head" property="article:published_time" content={entry.data.published.toISOString()} />
    {entry.data.updated && <meta slot="head" property="article:modified_time" content={entry.data.updated.toISOString()} />}
    {hasMath && <link slot="head" rel="stylesheet" href={katexStyleUrl} />}
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
        <div id="post-container" class:list={["card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full ",
            {}
        ]}>
            <!-- word count and reading time -->
            <div class="flex flex-row text-black/50 dark:text-white/50 gap-5 mb-3 transition onload-animation">
                <div class="flex flex-row items-center">
                    <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2">
                        <Icon name="material-symbols:notes-rounded"></Icon>
                    </div>
                    <div class="text-sm">{remarkPluginFrontmatter.words} {" " + i18n(I18nKey.wordsCount)}</div>
                </div>
                <div class="flex flex-row items-center">
                    <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2">
                        <Icon name="material-symbols:schedule-outline-rounded"></Icon>
                    </div>
                    <div class="text-sm">
                        {remarkPluginFrontmatter.minutes} {" " + i18n(remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}
                    </div>
                </div>
            </div>

            <!-- title: per-character kinetic reveal (server-split, CSS-driven) -->
            <div class="relative">
                <h1
                    data-pagefind-body data-pagefind-weight="10" data-pagefind-meta="title"
                    class="post-title transition w-full block font-bold mb-3
                    text-3xl md:text-[2.25rem]/[2.75rem]
                    text-black/90 dark:text-white/90
                    md:before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)]
                    before:absolute before:top-[0.75rem] before:left-[-1.125rem]
                "
                    aria-label={entry.data.title}
                >
                    {[...entry.data.title].map((ch, i) => (
                        <span class="post-title-mask" style={`--i:${i}`} aria-hidden="true">
                            <span class="post-title-char">{ch === " " ? " " : ch}</span>
                        </span>
                    ))}
                </h1>
            </div>

            <!-- metadata -->
            <div class="onload-animation">
                <PostMetadata
                        class="mb-5"
                        published={entry.data.published}
                        updated={entry.data.updated}
                        tags={entry.data.tags}
                        category={entry.data.category}
                ></PostMetadata>
                {!entry.data.image && <div class="border-[var(--line-divider)] border-dashed border-b-[1px] mb-5"></div>}
            </div>

            <!-- series navigation: only exists when the essay joins a named series -->
            {seriesPosts.length > 1 && (
                <aside class="series-box mb-6 onload-animation" aria-labelledby="series-heading">
                    <div class="series-head">
                        <span class="series-label">系列 · SERIES</span>
                        <span class="series-progress font-mono">{seriesIndex + 1} / {seriesPosts.length}</span>
                    </div>
                    <h2 id="series-heading" class="series-name">{entry.data.series}</h2>
                    <ol class="series-list">
                        {seriesPosts.map((p, i) => (
                            <li>
                                {p.slug === entry.slug ? (
                                    <span class="series-item is-current" aria-current="true">
                                        <span class="series-num">{String(i + 1).padStart(2, "0")}</span>
                                        <span class="series-item-title">{p.data.title}</span>
                                        <span class="series-here">阅读中</span>
                                    </span>
                                ) : (
                                    <a class="series-item" href={getPostUrlBySlug(p.slug)}>
                                        <span class="series-num">{String(i + 1).padStart(2, "0")}</span>
                                        <span class="series-item-title">{p.data.title}</span>
                                    </a>
                                )}
                            </li>
                        ))}
                    </ol>
                </aside>
            )}

            <!-- collapsible TOC below 2xl (the sidebar TOC only exists at 2xl+) -->
            {headings.filter((h) => h.depth >= 2 && h.depth <= 3).length > 0 && (
                <details class="mobile-toc 2xl:hidden mb-6 onload-animation">
                    <summary class="mobile-toc-summary">
                        <span class="mobile-toc-label">目录 · CONTENTS</span>
                        <Icon name="fa6-solid:chevron-down" class="mobile-toc-chevron" />
                    </summary>
                    <nav class="mobile-toc-nav" aria-label="文章目录">
                        {headings
                            .filter((h) => h.depth >= 2 && h.depth <= 3)
                            .map((h) => (
                                <a href={`#${h.slug}`} class="mobile-toc-link" style={`--depth:${h.depth - 2}`}>{h.text}</a>
                            ))}
                    </nav>
                </details>
            )}

            <!-- always show cover as long as it has one -->

            {entry.data.image &&
                <ImageWrapper id="post-cover" src={entry.data.image} basePath={path.join("content/posts/", getDir(entry.id))} class="mb-8 rounded-xl banner-container onload-animation"/>
            }


            <Markdown class="mb-6 markdown-content onload-animation">
                <Content />
            </Markdown>

            {licenseConfig.enable && <License title={entry.data.title} slug={entry.slug} pubDate={entry.data.published} class="mb-6 rounded-xl license-container onload-animation"></License>}

            {related.length > 0 && (
                <section class="related-posts mb-6" aria-labelledby="related-heading">
                    <h2 id="related-heading" class="related-heading">相关阅读 · RELATED</h2>
                    <ul class="related-list">
                        {related.map((p) => (
                            <li>
                                <a href={getPostUrlBySlug(p.slug)} class="related-link">
                                    <span class="related-title">{p.data.title}</span>
                                    <time class="related-date" datetime={p.data.published.toISOString()}>{formatDateToYYYYMMDD(p.data.published)}</time>
                                </a>
                            </li>
                        ))}
                    </ul>
                </section>
            )}

        </div>
    </div>

    <nav class="post-nav mb-4 w-full" aria-label="文章导航">
        {entry.data.nextSlug && <a href={getPostUrlBySlug(entry.data.nextSlug)}
           class="post-nav-link group"
           data-nav="next"
           data-magnetic="0.12">
            <span class="post-nav-label">下一篇 · NEXT</span>
            <span class="post-nav-title">
                <Icon name="fa6-solid:arrow-left" class="post-nav-arrow" />
                <span class="post-nav-text">{entry.data.nextTitle}</span>
            </span>
        </a>}

        {entry.data.prevSlug && <a href={getPostUrlBySlug(entry.data.prevSlug)}
           class="post-nav-link group md:text-right"
           data-nav="prev"
           data-magnetic="0.12">
            <span class="post-nav-label">上一篇 · PREV</span>
            <span class="post-nav-title md:justify-end">
                <span class="post-nav-text">{entry.data.prevTitle}</span>
                <Icon name="fa6-solid:arrow-right" class="post-nav-arrow" />
            </span>
        </a>}
    </nav>

</MainGridLayout>

<style>
    .post-nav {
        display: grid;
        grid-template-columns: 1fr;
        border-top: 1px solid var(--line-divider);
    }
    @media (min-width: 768px) {
        .post-nav {
            grid-template-columns: 1fr 1fr;
        }
    }

    .post-nav-link {
        display: block;
        padding: 1.6rem 0.25rem;
        transition: opacity 0.4s ease;
    }

    .post-nav-label {
        display: block;
        font-size: 0.68rem;
        letter-spacing: 0.38em;
        text-transform: uppercase;
        color: oklch(0.62 0.08 var(--hue));
        margin-bottom: 0.7rem;
    }

    .post-nav-title {
        display: flex;
        align-items: baseline;
        gap: 0.8rem;
        font-family: var(--font-display);
        font-size: 1.35rem;
        font-weight: 540;
        line-height: 1.3;
        letter-spacing: 0.01em;
        color: var(--deep-text);
    }

    .post-nav-text {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        transition:
            transform 0.6s var(--ease-out-expo),
            color 0.4s ease;
    }

    .post-nav-arrow {
        font-size: 0.85rem;
        color: var(--primary);
        opacity: 0.55;
        transition:
            transform 0.6s var(--ease-out-expo),
            opacity 0.4s ease;
    }

    @media (hover: hover) {
        .post-nav-link:hover .post-nav-text {
            color: var(--primary);
            transform: translateX(0.4rem);
        }
        .post-nav-link:hover .post-nav-arrow {
            opacity: 1;
            transform: translateX(-0.2rem);
        }
    }
    @media (hover: hover) and (min-width: 768px) {
        .post-nav-link.md\:text-right:hover .post-nav-text {
            transform: translateX(-0.4rem);
        }
        .post-nav-link.md\:text-right:hover .post-nav-arrow {
            transform: translateX(0.2rem);
        }
    }
</style>

<style>
    .post-title {
        font-family: var(--font-display);
        font-weight: 580;
        letter-spacing: 0.01em;
    }
    .post-title-mask {
        display: inline-block;
        overflow: hidden;
        vertical-align: bottom;
        padding-bottom: 0.1em;
        margin-bottom: -0.1em;
    }
    .post-title-char {
        display: inline-block;
        animation: post-char-rise 0.85s var(--ease-out-expo) both;
        animation-delay: calc(0.15s + min(var(--i) * 40ms, 640ms));
    }
    @keyframes post-char-rise {
        from {
            transform: translateY(110%) rotate(4deg);
            opacity: 0;
        }
        to {
            transform: translateY(0) rotate(0deg);
            opacity: 1;
        }
    }
</style>

<style>
    /* collapsible TOC (<2xl) */
    .mobile-toc {
        border: 1px solid var(--line-divider);
        border-radius: 0.75rem;
        overflow: hidden;
    }
    .mobile-toc-summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.8rem 1.1rem;
        cursor: pointer;
        list-style: none;
        font-family: var(--font-display);
        font-size: 0.95rem;
        font-weight: 560;
        letter-spacing: 0.08em;
        color: rgb(0 0 0 / 0.82);
        user-select: none;
    }
    :global(:root.dark) .mobile-toc-summary {
        color: rgb(255 255 255 / 0.85);
    }
    .mobile-toc-summary::-webkit-details-marker {
        display: none;
    }
    .mobile-toc-chevron {
        font-size: 0.7rem;
        opacity: 0.5;
        transition: transform 0.35s var(--ease-out-expo);
    }
    .mobile-toc[open] .mobile-toc-chevron {
        transform: rotate(180deg);
    }
    .mobile-toc-nav {
        display: flex;
        flex-direction: column;
        padding: 0 1.1rem 0.9rem;
    }
    .mobile-toc-link {
        padding: 0.32rem 0 0.32rem calc(var(--depth) * 1.2rem);
        font-size: 0.9rem;
        line-height: 1.5;
        color: rgb(0 0 0 / 0.62);
        border-left: 2px solid transparent;
        transition: color 0.3s ease, border-color 0.3s ease;
    }
    :global(:root.dark) .mobile-toc-link {
        color: rgb(255 255 255 / 0.62);
    }
    @media (hover: hover) {
        .mobile-toc-link:hover {
            color: var(--primary);
            border-left-color: var(--primary);
        }
    }

    /* related reading */
    .related-posts {
        border-top: 1px solid var(--line-divider);
        padding-top: 1.4rem;
    }
    .related-heading {
        font-size: 0.68rem;
        letter-spacing: 0.38em;
        text-transform: uppercase;
        font-weight: 500;
        color: oklch(0.62 0.08 var(--hue));
        margin-bottom: 0.9rem;
    }
    .related-list {
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
        list-style: none;
        padding: 0;
        margin: 0;
    }
    .related-link {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
    }
    .related-title {
        font-family: var(--font-display);
        font-size: 1.1rem;
        font-weight: 540;
        line-height: 1.4;
        color: rgb(0 0 0 / 0.82);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        transition: color 0.3s ease, transform 0.5s var(--ease-out-expo);
    }
    :global(:root.dark) .related-title {
        color: rgb(255 255 255 / 0.85);
    }
    .related-date {
        flex-shrink: 0;
        font-family: var(--font-mono, ui-monospace, monospace);
        font-size: 0.72rem;
        letter-spacing: 0.12em;
        color: rgb(0 0 0 / 0.4);
    }
    :global(:root.dark) .related-date {
        color: rgb(255 255 255 / 0.4);
    }
    @media (hover: hover) {
        .related-link:hover .related-title {
            color: var(--primary);
            transform: translateX(0.35rem);
        }
    }

    /* series navigation */
    .series-box {
        border: 1px solid var(--line-divider);
        border-radius: 0.75rem;
        padding: 1.1rem 1.25rem 0.9rem;
        background: color-mix(in oklab, var(--btn-regular-bg) 45%, transparent);
    }
    .series-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        margin-bottom: 0.35rem;
    }
    .series-label {
        font-size: 0.68rem;
        letter-spacing: 0.38em;
        text-transform: uppercase;
        font-weight: 500;
        color: oklch(0.62 0.08 var(--hue));
    }
    .series-progress {
        font-size: 0.72rem;
        letter-spacing: 0.15em;
        color: rgb(0 0 0 / 0.4);
    }
    :global(:root.dark) .series-progress {
        color: rgb(255 255 255 / 0.4);
    }
    .series-name {
        font-family: var(--font-display);
        font-size: 1.45rem;
        font-weight: 560;
        line-height: 1.25;
        letter-spacing: 0.01em;
        color: rgb(0 0 0 / 0.85);
        margin-bottom: 0.7rem;
    }
    :global(:root.dark) .series-name {
        color: rgb(255 255 255 / 0.88);
    }
    .series-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
    }
    .series-item {
        display: flex;
        align-items: baseline;
        gap: 0.8rem;
        padding: 0.42rem 0.5rem;
        margin: 0 -0.5rem;
        border-radius: 0.5rem;
        border-left: 2px solid transparent;
        font-size: 0.95rem;
        color: rgb(0 0 0 / 0.62);
        transition: color 0.3s ease, border-color 0.3s ease, background 0.3s ease;
    }
    :global(:root.dark) .series-item {
        color: rgb(255 255 255 / 0.62);
    }
    .series-num {
        font-style: italic;
        font-size: 0.72rem;
        font-weight: 480;
        color: oklch(0.68 0.12 var(--hue));
        opacity: 0.8;
    }
    .series-item-title {
        font-family: var(--font-display);
        font-weight: 520;
        letter-spacing: 0.01em;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .series-item.is-current {
        color: var(--primary);
        border-left-color: var(--primary);
        background: var(--btn-plain-bg-hover);
    }
    .series-here {
        flex-shrink: 0;
        margin-left: auto;
        font-size: 0.66rem;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        color: var(--primary);
        opacity: 0.75;
    }
    @media (hover: hover) {
        a.series-item:hover {
            color: var(--primary);
            border-left-color: var(--primary);
            background: var(--btn-plain-bg-hover);
        }
    }

    /* --deep-text is a single light-mode value; the post-nav title
       inherited it and went invisible on dark cards */
    :global(:root.dark) .post-nav-title {
        color: rgb(255 255 255 / 0.85);
    }
</style>

<script>
    // ←/→ flip between posts. Bound once globally; the current page's nav
    // links are resolved at key time, so it stays correct across Swup swaps
    // (and SwupScriptsPlugin re-executions hit the guard).
    if (!(window as any).__postFlipKeys) {
        (window as any).__postFlipKeys = true;
        document.addEventListener("keydown", (e) => {
            if (e.defaultPrevented || e.metaKey || e.ctrlKey || e.altKey) return;
            const t = e.target as HTMLElement | null;
            if (
                t &&
                (t.tagName === "INPUT" ||
                    t.tagName === "TEXTAREA" ||
                    t.isContentEditable)
            )
                return;
            if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
            const link = document.querySelector<HTMLAnchorElement>(
                e.key === "ArrowLeft" ? "[data-nav='next']" : "[data-nav='prev']",
            );
            if (!link) return;
            e.preventDefault();
            const swup = (window as any).swup;
            if (swup?.navigate) swup.navigate(link.href);
            else window.location.href = link.href;
        });
    }
</script>
