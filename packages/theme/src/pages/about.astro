---

import { getEntry, render } from "astro:content";
import { siteConfig } from "@site/config";
import Markdown from "../components/misc/Markdown.astro";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";

const aboutLabel = siteConfig.about?.label ?? "ABOUT · 关于这个本子";
const aboutRuleText = siteConfig.about?.ruleText ?? "随笔 · 手札 · 留白";
const aboutSignature = siteConfig.about?.signature ?? "—— 随笔手札";

const aboutPost = await getEntry("spec", "about");

if (!aboutPost) {
	throw new Error("About page content not found");
}

const { Content } = await render(aboutPost);
---
<MainGridLayout title={i18n(I18nKey.about)} description={i18n(I18nKey.about)}>
    <div class="about-hero card-base relative w-full overflow-hidden px-7 md:px-14 pt-14 pb-12 md:pt-20 md:pb-16">
        <div class="about-label" data-reveal>{aboutLabel}</div>
        <h1 class="about-title" aria-label="关于 About">
            <span class="about-title-char" style="--d:0">关</span><span class="about-title-char" style="--d:1">于</span><span class="about-title-ghost" style="--d:2">About</span>
        </h1>
        <div class="about-rule" data-reveal data-reveal-delay="0.35">
            <span class="about-rule-line"></span>
            <span class="about-rule-text">{aboutRuleText}</span>
        </div>
        <div class="about-body">
            <Markdown class="about-md mt-0">
                <Content />
            </Markdown>
            <div class="about-signature" data-reveal data-reveal-delay="0.2">{aboutSignature}</div>
        </div>
    </div>
</MainGridLayout>

<style>
    .about-hero {
        background-image: radial-gradient(
            ellipse 55% 40% at 85% 0%,
            oklch(0.7 0.1 var(--hue) / 0.08),
            transparent 70%
        );
    }

    .about-label {
        font-size: 0.72rem;
        letter-spacing: 0.42em;
        text-transform: uppercase;
        color: oklch(0.62 0.08 var(--hue));
        margin-bottom: 1.5rem;
    }

    .about-title {
        font-family: var(--font-display);
        font-size: clamp(3.2rem, 9vw, 6.5rem);
        font-weight: 560;
        line-height: 1.02;
        letter-spacing: -0.01em;
        color: var(--deep-text);
        display: flex;
        align-items: baseline;
        flex-wrap: wrap;
        column-gap: 0.35em;
    }

    .about-title-char,
    .about-title-ghost {
        display: inline-block;
        animation: about-rise 1s var(--ease-out-expo) both;
        animation-delay: calc(0.1s + var(--d) * 0.12s);
    }

    .about-title-ghost {
        font-style: italic;
        font-weight: 400;
        font-size: 0.62em;
        color: transparent;
        -webkit-text-stroke: 1.5px oklch(0.72 0.12 var(--hue));
    }

    @keyframes about-rise {
        from {
            opacity: 0;
            transform: translateY(0.4em) rotate(1.5deg);
            filter: blur(8px);
        }
        to {
            opacity: 1;
            transform: translateY(0) rotate(0deg);
            filter: blur(0);
        }
    }

    .about-rule {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-top: 2.25rem;
    }

    .about-rule-line {
        height: 1px;
        width: 4.5rem;
        background: linear-gradient(
            to right,
            oklch(0.7 0.12 var(--hue) / 0.7),
            transparent
        );
    }

    .about-rule-text {
        font-size: 0.72rem;
        letter-spacing: 0.35em;
        color: var(--deep-text);
        opacity: 0.55;
    }

    .about-body {
        margin-top: 3rem;
        max-width: 44rem;
    }

    /* editorial lede: the opening paragraph is set larger, in serif italic */
    .about-md :global(p:first-of-type) {
        font-family: var(--font-display);
        font-size: 1.35rem;
        font-style: italic;
        font-weight: 420;
        line-height: 1.75;
        letter-spacing: 0.02em;
        color: var(--deep-text);
        margin-bottom: 1.75rem;
    }

    .about-md :global(p) {
        line-height: 2;
        letter-spacing: 0.03em;
    }

    .about-signature {
        margin-top: 3rem;
        font-family: var(--font-display);
        font-style: italic;
        font-size: 1.05rem;
        text-align: right;
        color: oklch(0.62 0.1 var(--hue));
        letter-spacing: 0.1em;
    }
</style>
