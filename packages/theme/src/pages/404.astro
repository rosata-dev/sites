---
import { Icon } from "astro-icon/components";
import MainGridLayout from "../layouts/MainGridLayout.astro";
---

<MainGridLayout title="404" description="Page not found">
    <meta slot="head" name="robots" content="noindex" />
    <div class="void-stage card-base relative w-full overflow-hidden min-h-[32rem] md:min-h-[36rem] flex items-center justify-center">
        <canvas id="void-canvas" aria-hidden="true"></canvas>
        <div class="relative z-10 flex flex-col items-center text-center px-6 py-16 pointer-events-none">
            <div class="void-label" data-reveal>ERR · 404 / SIGNAL LOST</div>
            <h1 class="void-digits" aria-label="404">
                <span class="void-digit" style="--d:0">4</span>
                <span class="void-digit void-digit-ghost" style="--d:1">0</span>
                <span class="void-digit" style="--d:2">4</span>
            </h1>
            <p class="void-note" data-reveal data-reveal-delay="0.15">
                你寻找的页面已迷失于噪点与引力之间
            </p>
            <a href="/" class="void-home pointer-events-auto group" data-magnetic="0.3" data-reveal data-reveal-delay="0.3">
                <span>回到首页</span>
                <Icon name="material-symbols:arrow-right-alt-rounded" class="text-xl transition-transform duration-500 group-hover:translate-x-1.5" />
            </a>
        </div>
    </div>
</MainGridLayout>

<style>
    .void-stage {
        /* static fallback texture under the generative canvas */
        background-image: radial-gradient(
            ellipse 60% 50% at 50% 46%,
            oklch(0.7 0.1 var(--hue) / 0.10),
            transparent 70%
        );
    }

    #void-canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
    }

    .void-label {
        font-size: 0.72rem;
        letter-spacing: 0.42em;
        text-transform: uppercase;
        color: oklch(0.62 0.08 var(--hue));
        margin-bottom: 1.25rem;
    }

    .void-digits {
        font-family: var(--font-display);
        font-size: clamp(7rem, 24vw, 15rem);
        font-weight: 560;
        line-height: 0.95;
        letter-spacing: -0.02em;
        color: var(--deep-text);
        display: flex;
        align-items: baseline;
    }

    .void-digit {
        display: inline-block;
        animation: void-rise 1.1s var(--ease-out-expo) both;
        animation-delay: calc(0.12s + var(--d) * 0.14s);
    }

    .void-digit-ghost {
        font-style: italic;
        font-weight: 400;
        color: transparent;
        -webkit-text-stroke: 2px oklch(0.72 0.12 var(--hue));
        animation:
            void-rise 1.1s var(--ease-out-expo) both,
            void-float 7s ease-in-out 1.4s infinite;
        animation-delay: calc(0.12s + var(--d) * 0.14s), 1.4s;
    }

    @keyframes void-rise {
        from {
            opacity: 0;
            transform: translateY(0.35em) rotate(2deg);
            filter: blur(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0) rotate(0deg);
            filter: blur(0);
        }
    }

    @keyframes void-float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-0.045em); }
    }

    .void-note {
        margin-top: 1.75rem;
        font-size: 0.95rem;
        letter-spacing: 0.08em;
        color: var(--deep-text);
        opacity: 0.72;
    }

    .void-home {
        margin-top: 2.75rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.8rem 1.9rem;
        border-radius: 999px;
        font-size: 0.9rem;
        letter-spacing: 0.14em;
        color: var(--btn-content);
        background: var(--btn-regular-bg);
        box-shadow: 0 0 0 1px oklch(0.7 0.1 var(--hue) / 0.25);
        transition: box-shadow 0.5s var(--ease-out-expo), background 0.3s;
    }

    .void-home:hover {
        background: var(--btn-regular-bg-hover);
        box-shadow: 0 0 0 1px oklch(0.7 0.12 var(--hue) / 0.55),
            0 8px 32px -8px oklch(0.6 0.15 var(--hue) / 0.45);
    }
</style>
