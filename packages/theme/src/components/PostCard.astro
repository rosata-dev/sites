---
import type { CollectionEntry } from "astro:content";
import path from "node:path";
import { Icon } from "astro-icon/components";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { formatDateToYYYYMMDD } from "../utils/date-utils";
import { getDir } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";
import PostMetadata from "./PostMeta.astro";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	image: string;
	description: string;
	draft: boolean;
	style?: string;
	revealDelay?: number;
	index?: number;
}
const {
	entry,
	title,
	url,
	published,
	updated,
	tags,
	category,
	image,
	description,
	style,
	revealDelay,
	index,
} = Astro.props;
const className = Astro.props.class;

const hasCover = image !== undefined && image !== null && image !== "";

const coverWidth = "28%";

const { remarkPluginFrontmatter } = await entry.render();
---
<div class:list={["post-card card-base flex flex-col-reverse md:flex-col w-full rounded-[var(--radius-large)] overflow-hidden relative lg:hidden", className]} style={style} data-reveal data-reveal-delay={revealDelay}>
    <div class:list={["pl-6 md:pl-9 pr-6 md:pr-2 pt-6 md:pt-7 pb-6 relative", {"w-full md:w-[calc(100%_-_52px_-_12px)]": !hasCover, "w-full md:w-[calc(100%_-_var(--coverWidth)_-_12px)]": hasCover}]}>
        <a href={url}
           class="post-card-title transition group w-full block mb-3 text-3xl text-90
        hover:text-[var(--primary)] dark:hover:text-[var(--primary)]
        active:text-[var(--title-active)] dark:active:text-[var(--title-active)]
        before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)]
        before:absolute before:top-[35px] before:left-[18px] before:hidden md:before:block
        ">
            {title}
            <Icon class="inline text-[2rem] text-[var(--primary)] md:hidden translate-y-0.5 absolute" name="material-symbols:chevron-right-rounded" ></Icon>
            <Icon class="text-[var(--primary)] text-[2rem] transition hidden md:inline absolute translate-y-0.5 opacity-0 group-hover:opacity-100 -translate-x-1 group-hover:translate-x-0" name="material-symbols:chevron-right-rounded"></Icon>
        </a>

        <!-- metadata -->
        <PostMetadata published={published} updated={updated} tags={tags} category={category} hideTagsForMobile={true} hideUpdateDate={true} class="mb-4"></PostMetadata>

        <!-- description -->
        <div class:list={["transition text-75 mb-3.5 pr-4", {"line-clamp-2 md:line-clamp-1": !description}]}>
            { description || remarkPluginFrontmatter.excerpt }
        </div>

        <!-- word count and read time  -->
        <div class="text-sm text-black/30 dark:text-white/30 flex gap-4 transition">
            <div>
                {remarkPluginFrontmatter.words} {" " + i18n(remarkPluginFrontmatter.words === 1 ? I18nKey.wordCount : I18nKey.wordsCount)}
            </div>
            <div>|</div>
            <div>
                {remarkPluginFrontmatter.minutes} {" " + i18n(remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}
            </div>
        </div>

    </div>

    {hasCover && <a href={url} aria-label={title}
                    class:list={["post-card-cover group",
                        "max-h-[20vh] md:max-h-none mx-4 mt-4 -mb-2 md:mb-0 md:mx-0 md:mt-0",
                        "md:w-[var(--coverWidth)] relative md:absolute md:top-3 md:bottom-3 md:right-3 rounded-xl overflow-hidden active:scale-95"
                    ]} >
        <div class="absolute pointer-events-none z-10 w-full h-full group-hover:bg-black/30 group-active:bg-black/50 transition"></div>
        <div class="absolute pointer-events-none z-20 w-full h-full flex items-center justify-center ">
            <Icon name="material-symbols:chevron-right-rounded"
                  class="transition opacity-0 group-hover:opacity-100 scale-50 group-hover:scale-100 text-white text-5xl">
            </Icon>
        </div>
        <ImageWrapper src={image} basePath={path.join("content/posts/", getDir(entry.id))} alt="Cover Image of the Post"
                  class="w-full h-full">
        </ImageWrapper>
    </a>}

    {!hasCover &&
        <a href={url} aria-label={title} class="!hidden md:!flex btn-regular w-[3.25rem]
         absolute right-3 top-3 bottom-3 rounded-xl bg-[var(--enter-btn-bg)]
         hover:bg-[var(--enter-btn-bg-hover)] active:bg-[var(--enter-btn-bg-active)] active:scale-95
        ">
            <Icon name="material-symbols:chevron-right-rounded"
                  class="transition text-[var(--primary)] text-4xl mx-auto">
            </Icon>
        </a>
    }
</div>
<div class="transition border-t-[1px] border-dashed mx-6 border-black/10 dark:border-white/[0.15] last:border-t-0 md:hidden"></div>

<!-- Desktop editorial index row: pure typography, Aristide-style -->
<a href={url} aria-label={title}
   class="editorial-row hidden lg:flex items-start gap-6 relative py-8 group"
   data-reveal data-reveal-delay={revealDelay}
   style={`--row-delay:${revealDelay ?? 0}s`}
>
    <span class="editorial-index pt-3 w-10 shrink-0 text-right select-none">
        {index !== undefined ? String(index + 1).padStart(2, "0") : ""}
    </span>
    <span class="flex-1 min-w-0">
        <span class="editorial-title font-display block text-black/90 dark:text-white/90">
            {title}
        </span>
        <span class="editorial-excerpt block mt-2.5 text-[0.95rem] leading-relaxed text-black/55 dark:text-white/55 line-clamp-1 transition-colors duration-500">
            {description || remarkPluginFrontmatter.excerpt}
        </span>
        <span class="block mt-3 font-mono text-xs tracking-wider text-black/35 dark:text-white/35 select-none">
            {formatDateToYYYYMMDD(published)}
            {category && <span class="mx-2">/</span>}
            {category}
            <span class="mx-2">/</span>
            {remarkPluginFrontmatter.minutes}{" " + i18n(I18nKey.minutesCount)}
        </span>
    </span>
    <span class="editorial-arrow shrink-0 self-center w-11 h-11 rounded-full border border-[var(--line-divider)] flex items-center justify-center text-[var(--primary)]" data-magnetic="0.35">
        <Icon name="fa6-solid:arrow-right" class="text-base" />
    </span>
</a>

<style define:vars={{coverWidth}}>
</style>

<style>
    .post-card-title {
        font-family: var(--font-display);
        font-weight: 580;
        letter-spacing: 0.01em;
        line-height: 1.25;
    }

    /* Editorial index row choreography (desktop) */
    .editorial-row {
        border-top: 1px solid var(--line-divider);
        transition: background-color 0.5s ease;
    }
    /* the divider line draws itself in from the left as the row arrives */
    .editorial-row::before {
        content: "";
        position: absolute;
        top: -1px;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(
            to right,
            oklch(0.7 0.12 var(--hue) / 0.55),
            oklch(0.7 0.12 var(--hue) / 0.08)
        );
        transform: scaleX(0);
        transform-origin: left center;
        animation: row-line-draw 1.1s var(--ease-out-expo) forwards;
        animation-delay: calc(0.25s + var(--row-delay, 0s));
    }
    @keyframes row-line-draw {
        to { transform: scaleX(1); }
    }
    .editorial-row:last-child {
        border-bottom: 1px solid var(--line-divider);
    }
    .editorial-index {
        font-family: var(--font-display);
        font-style: italic;
        font-size: 0.9rem;
        font-weight: 480;
        color: var(--meta-divider);
        transition: color 0.5s var(--ease-out-expo);
    }
    .editorial-title {
        font-family: var(--font-display);
        font-size: clamp(1.55rem, 2.3vw, 2.15rem);
        font-weight: 560;
        line-height: 1.15;
        letter-spacing: 0.005em;
        transform: translateX(0);
        transition:
            transform 0.65s var(--ease-out-expo),
            color 0.4s ease;
        will-change: transform;
    }
    .editorial-arrow {
        opacity: 0;
        transform: translateX(-0.75rem) scale(0.85);
        transition:
            transform 0.55s var(--ease-out-expo),
            opacity 0.45s ease,
            background-color 0.45s ease;
    }
    @media (hover: hover) {
        .editorial-row:hover .editorial-title {
            transform: translateX(1.1rem);
            color: var(--primary);
        }
        .editorial-row:hover .editorial-index {
            color: var(--primary);
        }
        .editorial-row:hover .editorial-excerpt {
            color: var(--btn-content);
        }
        .editorial-row:hover .editorial-arrow {
            opacity: 1;
            transform: translateX(0) scale(1);
            background-color: var(--btn-plain-bg-hover);
        }
    }
</style>

<style is:global>
    /* Card hover choreography — hand-tuned easings, no default transitions */
    @media (hover: hover) {
        .post-card {
            transition:
                transform 0.7s var(--ease-out-expo),
                box-shadow 0.7s var(--ease-out-expo),
                background-color 0.3s ease;
        }
        .post-card:hover {
            transform: translateY(-4px);
            box-shadow:
                0 1.5rem 3.5rem -1.5rem oklch(0.5 0.08 var(--hue) / 0.35),
                0 0.25rem 1rem -0.5rem oklch(0.5 0.08 var(--hue) / 0.18);
        }
        :root.dark .post-card:hover {
            box-shadow:
                0 1.5rem 3.5rem -1.25rem oklch(0.7 0.1 var(--hue) / 0.28),
                0 0.25rem 1rem -0.5rem rgb(0 0 0 / 0.5);
        }

        .post-card-cover img {
            transition:
                transform 1.1s var(--ease-out-expo),
                filter 1.1s var(--ease-out-expo) !important;
        }
        .post-card:hover .post-card-cover img {
            transform: scale(1.08) rotate(0.7deg);
            filter: saturate(1.18) contrast(1.04);
        }

        /* light sheen sweeping across the cover on hover */
        .post-card-cover::after {
            content: "";
            position: absolute;
            inset: -40%;
            z-index: 15;
            pointer-events: none;
            background: linear-gradient(
                105deg,
                transparent 42%,
                rgb(255 255 255 / 0.16) 50%,
                transparent 58%
            );
            transform: translateX(-70%) skewX(-8deg);
            transition: transform 1s var(--ease-in-out-luxe);
        }
        .post-card:hover .post-card-cover::after {
            transform: translateX(70%) skewX(-8deg);
        }
    }
</style>
