---
/**
 * HeroCanvas — generative art layer for the banner area.
 *
 * Desktop: raw WebGL2 fullscreen fragment shader (domain-warped fbm flow
 * field with chromatic dispersion), tinted by the site's hue token.
 * The cursor doubles as a gravity well: dwelling in the banner charges
 * it and the field itself swirls into a whirlpool around the cursor —
 * capture radius and pull grow with the accumulated charge; a fast
 * flick discharges the held mass back into the field.
 * Touch:   Canvas2D particle flow field with Verlet integration.
 * The static banner image stays underneath as LCP poster and as the
 * no-WebGL / reduced-motion fallback.
 *
 * Defenses:
 * - prefers-reduced-motion  → nothing initialises
 * - FPS meter               → resolution ladder / particle culling
 * - webglcontextlost        → graceful teardown, banner image remains
 * - hidden tab / offscreen  → render loop paused
 */
---

<div id="hero-fx" class="absolute inset-0 pointer-events-none overflow-hidden">
    <!-- theme-tinted veil: guarantees text contrast, doubles as fallback art -->
    <div class="hero-veil absolute inset-0"></div>
    <canvas id="hero-canvas" class="absolute inset-0 w-full h-full opacity-0"></canvas>
</div>

<style>
    .hero-veil {
        background:
            radial-gradient(120% 90% at 20% 110%, oklch(0.75 0.14 var(--hue) / 0.28), transparent 60%),
            radial-gradient(100% 80% at 85% -10%, oklch(0.7 0.12 calc(var(--hue) + 40) / 0.22), transparent 55%),
            linear-gradient(to top, var(--page-bg), transparent 45%);
    }
    :root.dark .hero-veil {
        background:
            radial-gradient(120% 90% at 20% 110%, oklch(0.55 0.14 var(--hue) / 0.32), transparent 60%),
            radial-gradient(100% 80% at 85% -10%, oklch(0.5 0.12 calc(var(--hue) + 40) / 0.25), transparent 55%),
            linear-gradient(to top, var(--page-bg), transparent 45%);
    }
    #hero-canvas {
        transition: opacity 1.4s var(--ease-in-out-luxe, ease);
    }
    #hero-canvas.is-live {
        opacity: 1;
    }
    html.reduced-motion #hero-canvas,
    #hero-fx.hero-webgl-failed #hero-canvas {
        display: none;
    }
</style>

<script>
import { sweep } from "../../utils/audio";
import { isTouch, reducedMotion } from "../../utils/motion";

const VERT = `#version 300 es
in vec2 a_pos;
void main() { gl_Position = vec4(a_pos, 0.0, 1.0); }
`;

const FRAG = `#version 300 es
precision highp float;

uniform vec2  u_res;
uniform float u_time;
uniform vec2  u_mouse;   // cursor pos in canvas-uv space, lerped
uniform float u_vel;     // smoothed pointer speed 0..~1.5
uniform float u_well;    // gravity-well charge 0..1 (held-field fraction)
uniform float u_hue;     // 0..1
uniform float u_dark;    // 0..1
uniform float u_fade;    // intro fade 0..1

out vec4 outColor;

float hash(vec2 p) {
    p = fract(p * vec2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
}

float noise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    float a = hash(i);
    float b = hash(i + vec2(1.0, 0.0));
    float c = hash(i + vec2(0.0, 1.0));
    float d = hash(i + vec2(1.0, 1.0));
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

const mat2 ROT = mat2(0.8, 0.6, -0.6, 0.8);

float fbm(vec2 p) {
    float v = 0.0;
    float a = 0.5;
    for (int i = 0; i < 4; i++) {
        v += a * noise(p);
        p = ROT * p * 2.02;
        a *= 0.55;
    }
    return v;
}

// Analogous-hue cosine palette around the site hue
vec3 pal(float t, float h) {
    vec3 d = vec3(h, fract(h + 0.07), fract(h + 0.14));
    return vec3(0.5) + vec3(0.5) * cos(6.28318 * (vec3(1.0) * t + d));
}

void main() {
    vec2 uv = (gl_FragCoord.xy * 2.0 - u_res) / min(u_res.x, u_res.y);
    float t = u_time * 0.028;
    vec2 wc = u_mouse;                   // well centre = exact cursor

    // slow breathing of the whole field
    uv *= 1.0 + 0.035 * sin(u_time * 0.07);

    // pointer speed stirs the liquid: fast cursor = stronger warp;
    // a charged gravity well stirs it just the same
    float stir = clamp(u_vel + u_well * 0.9, 0.0, 1.5);

    // gravity well: a charged cursor swallows the field itself. The
    // capture radius grows with charge, so the held mass (~wr²) does
    // too — the positive feedback the game loop runs on. Held matter
    // keeps orbiting: the twist angle advances with u_time.
    vec2 uv0 = uv;                       // unwarped, cursor-centric terms
    float wr = 0.3 + 0.6 * u_well;
    vec2 toM = uv0 - wc;
    float cap = u_well * exp(-dot(toM, toM) / (wr * wr));
    float tw = cap * (1.7 + 0.55 * u_time * u_well);
    float cs = cos(tw);
    float sn = sin(tw);
    uv = wc + mat2(cs, -sn, sn, cs) * (toM * (1.0 - 0.55 * cap));

    // water character: low frequency, broad forms — a calm deep lake,
    // not a stream. gentle directional current advects the whole field.
    vec2 fuv = uv * vec2(0.55, 0.9);
    fuv += vec2(t * 0.35, t * 0.1);

    // double domain warp — slow liquid flow field, small amplitudes
    vec2 q = vec2(
        fbm(fuv + t),
        fbm(fuv + vec2(5.2, 1.3) - t)
    );
    vec2 r = vec2(
        fbm(fuv + (1.4 + 0.5 * stir) * q + vec2(1.7, 9.2) + wc * 0.35 + 0.15 * t),
        fbm(fuv + (1.4 + 0.5 * stir) * q + vec2(8.3, 2.8) - wc * 0.35 - 0.12 * t)
    );
    float f = fbm(fuv + (1.6 + 0.4 * stir) * r);

    // chromatic dispersion: barely-there, only near a fast cursor
    float dispersion = 0.006 + 0.04 * exp(-1.8 * length(uv0 - wc)) + 0.02 * stir;
    float fR = fbm(fuv + 1.6 * r + vec2(dispersion, 0.0));
    float fB = fbm(fuv + 1.6 * r - vec2(dispersion, 0.0));
    vec3 col = vec3(
        pal(fR + 0.35 * length(q) + 0.15 * length(r), u_hue).r,
        pal(f + 0.35 * length(q) + 0.15 * length(r), u_hue).g,
        pal(fB + 0.35 * length(q) + 0.15 * length(r), u_hue).b
    );

    // faint broad sheen on the swells — no scratchy threads
    float ridge = pow(clamp(1.0 - abs(f * 2.0 - 1.0), 0.0, 1.0), 4.0);
    col += ridge * (0.1 + 0.07 * stir) * pal(f + 0.5, fract(u_hue + 0.08));

    // soft glow following the cursor — brightens as the well charges
    float glow = exp(-2.2 * length(uv0 - wc));
    col += glow * (0.12 + 0.26 * u_well) * pal(f + 0.25, u_hue);

    // theme adaptation — low contrast, the field stays a whisper
    vec3 darkBase = vec3(0.055, 0.055, 0.075);
    vec3 lightBase = vec3(0.965, 0.96, 0.955);
    vec3 themed = mix(
        mix(lightBase, col, clamp(f * f * 0.9, 0.0, 1.0)),
        mix(darkBase, col * 0.75, clamp(f * 1.05, 0.0, 1.0)),
        u_dark
    );

    // vignette (unwarped frame, so the well can't distort the border)
    themed *= 1.0 - 0.35 * smoothstep(0.55, 1.6, length(uv0));

    // dithering to kill banding
    themed += (hash(gl_FragCoord.xy + u_time) - 0.5) * 0.015;

    outColor = vec4(themed * u_fade + (1.0 - u_fade) * vec3(0.0), 1.0);
}
`;

interface HeroGL {
    destroy: () => void;
}

/**
 * Canvas2D particle flow field with Verlet integration — the generative
 * layer for touch devices, where the fragment shader would be too heavy.
 * Particles are velocity-less (Verlet): position delta carries momentum,
 * a trigonometric curl-ish field supplies acceleration, strokes leave
 * fading trails via a low-alpha page-bg wash.
 */
function createHeroParticles(canvas: HTMLCanvasElement): HeroGL | null {
    const ctx = canvas.getContext("2d", { alpha: false });
    if (!ctx) return null;

    let hue = 205;
    let dark = true;
    let pageBg = "rgb(10, 10, 14)";
    const readTheme = () => {
        const styles = getComputedStyle(document.documentElement);
        const parsedHue = Number.parseFloat(
            styles.getPropertyValue("--hue").trim(),
        );
        if (!Number.isNaN(parsedHue)) hue = parsedHue;
        dark = document.documentElement.classList.contains("dark");
        const bg = styles.getPropertyValue("--page-bg").trim();
        if (bg) pageBg = bg;
    };
    readTheme();
    const themeObserver = new MutationObserver(readTheme);
    themeObserver.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["class", "style"],
    });

    const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
    const resize = () => {
        const w = Math.max(1, Math.floor(canvas.clientWidth * dpr));
        const h = Math.max(1, Math.floor(canvas.clientHeight * dpr));
        if (canvas.width !== w || canvas.height !== h) {
            canvas.width = w;
            canvas.height = h;
        }
    };
    resize();
    const ro = new ResizeObserver(resize);
    ro.observe(canvas);

    /* fade wash: derive an alpha variant of the page background */
    const fadeColor = () => {
        if (pageBg.startsWith("oklch(")) {
            return `${pageBg.slice(0, -1)} / 0.09)`;
        }
        return dark ? "rgba(8, 8, 12, 0.09)" : "rgba(245, 245, 248, 0.09)";
    };
    const strokeColor = () =>
        dark
            ? `hsla(${hue}, 75%, 66%, 0.38)`
            : `hsla(${hue}, 60%, 45%, 0.3)`;

    interface Particle {
        x: number;
        y: number;
        px: number;
        py: number;
        life: number;
    }

    const COUNT_BASE = 220;
    let count = COUNT_BASE;
    const particles: Particle[] = [];
    const spawn = (p: Particle) => {
        p.x = Math.random() * canvas.width;
        p.y = Math.random() * canvas.height;
        p.px = p.x;
        p.py = p.y;
        p.life = 240 + Math.random() * 360;
    };
    for (let i = 0; i < COUNT_BASE; i++) {
        const p: Particle = { x: 0, y: 0, px: 0, py: 0, life: 0 };
        spawn(p);
        p.life = Math.random() * 400; // desynchronise the first generation
        particles.push(p);
    }

    const flowAngle = (x: number, y: number, t: number) => {
        const s = 0.0024 / dpr;
        return (
            (Math.sin(x * s + t * 0.26) +
                Math.cos(y * s * 1.35 - t * 0.17) +
                Math.sin((x + y) * s * 0.55 + t * 0.11)) *
            1.4
        );
    };

    /* pointer attractor (touch drag / stylus) */
    let attractX = -9999;
    let attractY = -9999;
    const onPointerMove = (e: PointerEvent) => {
        const rect = canvas.getBoundingClientRect();
        attractX = (e.clientX - rect.left) * dpr;
        attractY = (e.clientY - rect.top) * dpr;
    };
    const onPointerEnd = () => {
        attractX = -9999;
        attractY = -9999;
    };
    window.addEventListener("pointermove", onPointerMove, { passive: true });
    window.addEventListener("pointercancel", onPointerEnd);
    window.addEventListener("pointerup", onPointerEnd);

    /* perf meter: cull particles when the frame budget slips */
    const frameTimes: number[] = [];
    const evaluatePerf = () => {
        if (frameTimes.length < 60) return;
        const avg = frameTimes.reduce((a, b) => a + b, 0) / frameTimes.length;
        frameTimes.length = 0;
        if (1000 / avg < 45 && count > 80) {
            count = Math.floor(count * 0.7);
        }
    };

    let raf = 0;
    let running = true;
    let visible = true;
    let inView = true;
    let last = performance.now();
    const start = last;
    let warm = 0;

    const loop = (now: number) => {
        if (!running) return;
        raf = requestAnimationFrame(loop);
        if (!visible || !inView) {
            last = now;
            return;
        }
        const dt = now - last;
        last = now;
        if (dt < 250) frameTimes.push(dt);
        evaluatePerf();

        const t = (now - start) / 1000;
        const W = canvas.width;
        const H = canvas.height;

        ctx.fillStyle = fadeColor();
        ctx.fillRect(0, 0, W, H);
        ctx.strokeStyle = strokeColor();
        ctx.lineWidth = dpr;
        ctx.beginPath();
        for (let i = 0; i < count; i++) {
            const p = particles[i];
            // Verlet: momentum lives in the position delta
            const vx = (p.x - p.px) * 0.94;
            const vy = (p.y - p.py) * 0.94;
            p.px = p.x;
            p.py = p.y;
            const a = flowAngle(p.x, p.y, t);
            // gentle directional current keeps the motion water-like
            let ax = Math.cos(a) * 0.4 * dpr + 0.06 * dpr;
            let ay = Math.sin(a) * 0.4 * dpr + 0.015 * dpr;
            const dxA = attractX - p.x;
            const dyA = attractY - p.y;
            const d2 = dxA * dxA + dyA * dyA;
            if (d2 < 90000 * dpr) {
                const d = Math.sqrt(d2) || 1;
                ax += (dxA / d) * 0.65;
                ay += (dyA / d) * 0.65;
            }
            p.x += vx + ax;
            p.y += vy + ay;
            if (--p.life <= 0 || p.x < -8 || p.x > W + 8 || p.y < -8 || p.y > H + 8) {
                spawn(p);
                continue;
            }
            ctx.moveTo(p.px, p.py);
            ctx.lineTo(p.x, p.y);
        }
        ctx.stroke();

        if (++warm === 20) canvas.classList.add("is-live");
    };
    // prime the wash so the first strokes don't streak over the banner
    ctx.fillStyle = pageBg;
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    raf = requestAnimationFrame(loop);

    const onVisibility = () => {
        visible = document.visibilityState === "visible";
    };
    document.addEventListener("visibilitychange", onVisibility);
    const io = new IntersectionObserver(
        (entries) => {
            inView = entries[0]?.isIntersecting ?? true;
        },
        { rootMargin: "80px" },
    );
    io.observe(canvas);

    return {
        destroy() {
            running = false;
            cancelAnimationFrame(raf);
            ro.disconnect();
            io.disconnect();
            themeObserver.disconnect();
            document.removeEventListener("visibilitychange", onVisibility);
            window.removeEventListener("pointermove", onPointerMove);
            window.removeEventListener("pointercancel", onPointerEnd);
            window.removeEventListener("pointerup", onPointerEnd);
        },
    };
}

function createHeroGL(canvas: HTMLCanvasElement): HeroGL | null {
    const gl = canvas.getContext("webgl2", {
        antialias: false,
        depth: false,
        stencil: false,
        alpha: false,
        powerPreference: "high-performance",
    });
    if (!gl) return null;

    const compile = (type: number, src: string) => {
        const sh = gl.createShader(type);
        if (!sh) return null;
        gl.shaderSource(sh, src);
        gl.compileShader(sh);
        if (!gl.getShaderParameter(sh, gl.COMPILE_STATUS)) {
            console.error("[hero] shader compile failed", gl.getShaderInfoLog(sh));
            gl.deleteShader(sh);
            return null;
        }
        return sh;
    };

    const vs = compile(gl.VERTEX_SHADER, VERT);
    const fs = compile(gl.FRAGMENT_SHADER, FRAG);
    if (!vs || !fs) return null;

    const prog = gl.createProgram();
    if (!prog) return null;
    gl.attachShader(prog, vs);
    gl.attachShader(prog, fs);
    gl.linkProgram(prog);
    gl.deleteShader(vs);
    gl.deleteShader(fs);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) {
        console.error("[hero] program link failed", gl.getProgramInfoLog(prog));
        return null;
    }
    gl.useProgram(prog);

    // fullscreen triangle
    const vao = gl.createVertexArray();
    gl.bindVertexArray(vao);
    const vbo = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, vbo);
    gl.bufferData(
        gl.ARRAY_BUFFER,
        new Float32Array([-1, -1, 3, -1, -1, 3]),
        gl.STATIC_DRAW,
    );
    const locPos = gl.getAttribLocation(prog, "a_pos");
    gl.enableVertexAttribArray(locPos);
    gl.vertexAttribPointer(locPos, 2, gl.FLOAT, false, 0, 0);

    const U = {
        res: gl.getUniformLocation(prog, "u_res"),
        time: gl.getUniformLocation(prog, "u_time"),
        mouse: gl.getUniformLocation(prog, "u_mouse"),
        vel: gl.getUniformLocation(prog, "u_vel"),
        well: gl.getUniformLocation(prog, "u_well"),
        hue: gl.getUniformLocation(prog, "u_hue"),
        dark: gl.getUniformLocation(prog, "u_dark"),
        fade: gl.getUniformLocation(prog, "u_fade"),
    };

    /* --- dynamic quality ladder driven by an FPS meter --- */
    const userDpr = Math.min(window.devicePixelRatio || 1, 2);
    const ladder = [2, 1.5, 1.25, 1, 0.8, 0.6].filter((v) => v <= userDpr);
    if (ladder.length === 0) ladder.push(userDpr);
    let qualityIdx = 0;
    let frameSkip = 0; // render every (frameSkip + 1)-th frame
    let frameCounter = 0;
    const frameTimes: number[] = [];

    const resize = () => {
        const dpr = ladder[qualityIdx];
        const w = Math.max(1, Math.floor(canvas.clientWidth * dpr));
        const h = Math.max(1, Math.floor(canvas.clientHeight * dpr));
        if (canvas.width !== w || canvas.height !== h) {
            canvas.width = w;
            canvas.height = h;
            gl.viewport(0, 0, w, h);
        }
    };
    resize();
    const ro = new ResizeObserver(resize);
    ro.observe(canvas);

    const evaluatePerf = () => {
        if (frameTimes.length < 60) return;
        const avg =
            frameTimes.reduce((a, b) => a + b, 0) / frameTimes.length;
        frameTimes.length = 0;
        const fps = 1000 / avg;
        if (fps < 45) {
            if (qualityIdx < ladder.length - 1) {
                qualityIdx++;
                resize();
            } else if (frameSkip < 2) {
                frameSkip++;
            }
        }
    };

    /* --- environment uniforms --- */
    let hue = 205;
    let dark = 1;
    const readTheme = () => {
        const styles = getComputedStyle(document.documentElement);
        const raw = styles.getPropertyValue("--hue").trim();
        const parsed = Number.parseFloat(raw);
        if (!Number.isNaN(parsed)) hue = parsed;
        dark = document.documentElement.classList.contains("dark") ? 1 : 0;
    };
    readTheme();
    const themeObserver = new MutationObserver(readTheme);
    themeObserver.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["class", "style"],
    });

    /* --- pointer field --- */
    const touch = isTouch();
    let mx = 0;
    let my = 0;
    let tx = 0;
    let ty = 0;
    // pointer speed, smoothed then decayed in the loop — drives the "stir"
    let vel = 0;
    let lastPX = 0;
    let lastPY = 0;
    // gravity-well charge: dwelling inside the banner band "drinks"
    // the field (charge → 1); a fast flick discharges the held mass
    let charge = 0;
    let inside = false;
    let lastClientY = -9999;
    let releaseT = 0;
    const FLICK = 0.8;
    const onPointerMove = (e: PointerEvent) => {
        // cursor position in the shader's uv space (canvas px → min-dim
        // normalised) — the well sits exactly under the pointer
        const rect = canvas.getBoundingClientRect();
        const px = ((e.clientX - rect.left) / rect.width) * canvas.width;
        const py = ((e.clientY - rect.top) / rect.height) * canvas.height;
        const mn = Math.min(canvas.width, canvas.height);
        const nx = (px * 2 - canvas.width) / mn;
        const ny = -((py * 2 - canvas.height) / mn);
        const jump = Math.hypot(nx - lastPX, ny - lastPY);
        vel = Math.min(1.5, vel + jump * 1.4);
        lastPX = nx;
        lastPY = ny;
        tx = nx;
        ty = ny;
        inside =
            e.clientY >= rect.top - 40 && e.clientY <= rect.bottom + 40;
        lastClientY = e.clientY;
    };
    const onPointerOut = (e: PointerEvent) => {
        if (!e.relatedTarget) inside = false;
    };
    // scrolling slides the banner under a parked cursor
    const onScroll = () => {
        if (lastClientY < -999) return;
        const rect = canvas.getBoundingClientRect();
        inside =
            lastClientY >= rect.top - 40 &&
            lastClientY <= rect.bottom + 40;
    };
    if (!touch) {
        window.addEventListener("pointermove", onPointerMove, {
            passive: true,
        });
        window.addEventListener("pointerout", onPointerOut);
        window.addEventListener("scroll", onScroll, { passive: true });
    }

    /* --- render loop with pause conditions --- */
    let raf = 0;
    let running = true;
    let visible = true;
    let inView = true;
    let start = performance.now();
    let last = start;
    let fade = 0;

    const loop = (now: number) => {
        if (!running) return;
        raf = requestAnimationFrame(loop);
        if (!visible || !inView) {
            last = now;
            return;
        }
        if (frameSkip > 0 && frameCounter++ % (frameSkip + 1) !== 0) {
            return;
        }
        const dt = now - last;
        last = now;
        if (dt < 250) frameTimes.push(dt);
        evaluatePerf();

        // idle drift on touch devices
        if (touch) {
            const s = (now - start) * 0.0001;
            tx = Math.sin(s * 2.1) * 0.6;
            ty = Math.cos(s * 1.7) * 0.4;
        }
        mx += (tx - mx) * 0.045;
        my += (ty - my) * 0.045;
        vel *= 0.94; // friction: the stir settles back to calm
        fade = Math.min(1, fade + dt / 1800);

        // charge dynamics — the game verb pair: dwell to gather,
        // flick to throw. Held mass ∝ charge (capture radius ~wr²
        // grows with it in the shader)
        releaseT = Math.max(0, releaseT - dt);
        if (releaseT === 0 && inside && charge > 0.08 && vel > FLICK) {
            releaseT = 420;
            charge *= 0.18; // the throw dumps most of the held field
            sweep();
        }
        if (inside && releaseT === 0 && vel < 0.4) {
            charge += (1 - charge) * Math.min(1, dt / 2400);
        } else if (!inside) {
            charge += (0 - charge) * Math.min(1, dt / 2600);
        }

        gl.uniform2f(U.res, canvas.width, canvas.height);
        gl.uniform1f(U.time, (now - start) / 1000);
        gl.uniform2f(U.mouse, mx, my);
        gl.uniform1f(U.vel, vel);
        gl.uniform1f(U.well, charge);
        gl.uniform1f(U.hue, ((hue % 360) + 360) % 360 / 360);
        gl.uniform1f(U.dark, dark);
        gl.uniform1f(U.fade, fade);
        gl.drawArrays(gl.TRIANGLES, 0, 3);

        if (fade > 0.15) canvas.classList.add("is-live");
    };
    raf = requestAnimationFrame(loop);

    const onVisibility = () => {
        visible = document.visibilityState === "visible";
    };
    document.addEventListener("visibilitychange", onVisibility);

    const io = new IntersectionObserver(
        (entries) => {
            inView = entries[0]?.isIntersecting ?? true;
        },
        { rootMargin: "80px" },
    );
    io.observe(canvas);

    /* --- context loss defence --- */
    let lost = false;
    const onLost = (e: Event) => {
        e.preventDefault();
        lost = true;
        running = false;
        cancelAnimationFrame(raf);
        canvas.classList.remove("is-live");
        canvas.closest("#hero-fx")?.classList.add("hero-webgl-failed");
    };
    const onRestored = () => {
        if (!lost) return;
        window.location.reload();
    };
    canvas.addEventListener("webglcontextlost", onLost);
    canvas.addEventListener("webglcontextrestored", onRestored);

    return {
        destroy() {
            running = false;
            cancelAnimationFrame(raf);
            ro.disconnect();
            io.disconnect();
            themeObserver.disconnect();
            document.removeEventListener("visibilitychange", onVisibility);
            if (!touch) {
                window.removeEventListener("pointermove", onPointerMove);
                window.removeEventListener("pointerout", onPointerOut);
                window.removeEventListener("scroll", onScroll);
            }
            canvas.removeEventListener("webglcontextlost", onLost);
            canvas.removeEventListener("webglcontextrestored", onRestored);
            gl.deleteBuffer(vbo);
            gl.deleteVertexArray(vao);
            gl.deleteProgram(prog);
            gl.getExtension("WEBGL_lose_context")?.loseContext();
        },
    };
}

function initHeroCanvas() {
    const canvas = document.getElementById(
        "hero-canvas",
    ) as HTMLCanvasElement | null;
    const fx = document.getElementById("hero-fx");
    if (!canvas || !fx) return;
    if (reducedMotion()) return;
    // Desktop: WebGL2 flow shader with chromatic dispersion.
    // Touch: Canvas2D Verlet particle flow field (lighter, no GPU shader).
    const instance = isTouch()
        ? createHeroParticles(canvas)
        : createHeroGL(canvas);
    if (!instance) {
        fx.classList.add("hero-webgl-failed");
        return;
    }
    // The banner lives outside the Swup containers and persists across
    // navigations; the GL context only needs teardown on full unload/HMR.
    window.addEventListener("pagehide", instance.destroy, { once: true });
    if (import.meta.hot) {
        import.meta.hot.dispose(instance.destroy);
    }
}

if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHeroCanvas, {
        once: true,
    });
} else {
    initHeroCanvas();
}
</script>
