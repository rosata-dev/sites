---
import { profileConfig } from "@site/config";
import { Icon } from "astro-icon/components";
import { url } from "../../utils/url-utils";
import ImageWrapper from "../misc/ImageWrapper.astro";

const config = profileConfig;
---
<div class="card-base p-3" data-tilt>
    {config.avatar ? (
        <a aria-label="Go to About Page" href={url('/about/')}
           class="group block relative mx-auto mt-1 lg:mx-0 lg:mt-0 mb-3
           max-w-[12rem] lg:max-w-none overflow-hidden rounded-xl active:scale-95">
            <div class="absolute transition pointer-events-none group-hover:bg-black/30 group-active:bg-black/50
            w-full h-full z-50 flex items-center justify-center">
                <Icon name="fa6-regular:address-card"
                      class="transition opacity-0 scale-90 group-hover:scale-100 group-hover:opacity-100 text-white text-5xl">
                </Icon>
            </div>
            <ImageWrapper src={config.avatar || ""} alt="Profile Image of the Author" class="mx-auto lg:w-full h-full lg:mt-0 "></ImageWrapper>
        </a>
    ) : (
        <a aria-label="Go to About Page" href={url('/about/')}
           class="group block mx-auto mt-1 lg:mx-0 lg:mt-0 mb-3 active:scale-95">
            <div class="flex aspect-square max-w-[12rem] lg:max-w-none items-center justify-center rounded-xl bg-[var(--primary)] text-white text-6xl italic font-[var(--font-display)]">
                札
            </div>
        </a>
    )}
    <div class="px-2">
        <div class="profile-name text-xl text-center mb-1.5 transition">{config.name}</div>
        <div class="profile-rule mx-auto mb-3 transition"></div>
        <div class="profile-bio text-center mb-3 transition">{config.bio}</div>
        <div class="flex flex-wrap gap-2 justify-center mb-1">
            {config.links.length > 1 && config.links.map(item =>
                    <a rel="me" aria-label={item.name} href={item.url} target="_blank" data-magnetic="0.3" class="btn-regular rounded-lg h-10 w-10 active:scale-90">
                        <Icon name={item.icon} class="text-[1.5rem]"></Icon>
                    </a>
            )}
            {config.links.length == 1 && <a rel="me" aria-label={config.links[0].name} href={config.links[0].url} target="_blank"
                                            data-magnetic="0.2"
                                            class="btn-regular rounded-lg h-10 gap-2 px-3 font-bold active:scale-95">
                <Icon name={config.links[0].icon} class="text-[1.5rem]"></Icon>
                {config.links[0].name}
            </a>}
        </div>
    </div>
</div>

<style>
    .profile-name {
        font-family: var(--font-display);
        font-weight: 560;
        letter-spacing: 0.05em;
        color: var(--deep-text);
    }

    .profile-rule {
        height: 1px;
        width: 3.5rem;
        background: linear-gradient(
            to right,
            transparent,
            oklch(0.7 0.13 var(--hue) / 0.8),
            transparent
        );
    }

    .profile-bio {
        font-family: var(--font-display);
        font-style: italic;
        font-size: 0.88rem;
        line-height: 1.8;
        letter-spacing: 0.04em;
        color: var(--deep-text);
        opacity: 0.62;
    }
</style>
