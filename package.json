{
	"name": "rosata-sites",
	"type": "module",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "pnpm --filter rosata-cn dev",
		"dev:template": "pnpm --filter site-template dev",
		"build": "pnpm -r build",
		"build:rosata-cn": "pnpm --filter rosata-cn build",
		"build:template": "pnpm --filter site-template build",
		"check": "pnpm -r check",
		"preview": "pnpm --filter rosata-cn preview",
		"new-post": "node scripts/new-post.js",
		"format": "biome format --write .",
		"lint": "biome check --write .",
		"preinstall": "npx only-allow pnpm"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15"
	},
	"packageManager": "pnpm@9.14.4"
}
