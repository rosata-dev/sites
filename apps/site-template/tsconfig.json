{
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"baseUrl": ".",
		"strictNullChecks": true,
		"allowJs": false,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"paths": {
			"@site/config": ["./src/config.ts"],
			"@/*": ["./src/*"]
		},
		"plugins": [
			{
				"name": "@astrojs/ts-plugin"
			}
		]
	},
	"include": ["src/**/*", "../../packages/theme/src/**/*"]
}
